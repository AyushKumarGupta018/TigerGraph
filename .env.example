# ------------------------------------------------------------------
# TigerGraph connection (Savanna or Community Edition)
# Leave OFFLINE_MODE=true to run everything against data/sample CSVs
# with zero infrastructure - handy for tests and quick demos.
# ------------------------------------------------------------------
TG_HOST=https://your-workspace.i.tgcloud.io
TG_GRAPH=FraudGraph
TG_USERNAME=tigergraph
TG_PASSWORD=
TG_SECRET=
OFFLINE_MODE=true

# ------------------------------------------------------------------
# LLM - the agent is provider-agnostic. The LLM does reasoning and
# synthesis; the graph does the heavy analytical lifting.
# ------------------------------------------------------------------
LLM_PROVIDER=openai            # openai | anthropic | none (deterministic fallback)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------
# Data + output locations. Point DATA_DIR at the extracted HHGOA_IEEE
# dataset for the real benchmark run.
# ------------------------------------------------------------------
DATA_DIR=./data/sample
OUTPUT_DIR=./output
