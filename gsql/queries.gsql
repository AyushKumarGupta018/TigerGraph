// GSQL queries for graph traversal, ring detection, and case memory retrieval
USE GRAPH FraudGraph

// 1. Evidence subgraph: 2-hop neighborhood around a transaction
CREATE QUERY evidence_subgraph(VERTEX<Transaction> txn) FOR GRAPH FraudGraph {
    SetAccum<EDGE> @@edges;
    start = {txn};
    hop1 = SELECT t FROM start:s -(ANY:e)- :t ACCUM @@edges += e;
    hop2 = SELECT t FROM hop1:s -(ANY:e)- :t ACCUM @@edges += e;
    PRINT hop1, hop2, @@edges;
}

// 2. Shared-attribute ring detection: entities sharing device, IP, or email
CREATE QUERY shared_attribute_ring(VERTEX<Customer> cust) FOR GRAPH FraudGraph {
    SumAccum<INT> @shared_links;
    seed = {cust};
    txns = SELECT t FROM seed -(CUSTOMER_TXN)- Transaction:t;
    attrs = SELECT a FROM txns -((USED_DEVICE|FROM_IP|USED_EMAIL|BILLED_TO))- :a;
    other_txns = SELECT t2 FROM attrs -((USED_DEVICE|FROM_IP|USED_EMAIL|BILLED_TO))- Transaction:t2;
    ring = SELECT c FROM other_txns -(CUSTOMER_TXN)- Customer:c
           WHERE c != cust
           ACCUM c.@shared_links += 1
           ORDER BY c.@shared_links DESC;
    PRINT ring[ring.customer_id, ring.@shared_links];
}

// 3. Velocity check: transaction volume and amount within trailing window
CREATE QUERY velocity_check(VERTEX<Card> card, DATETIME since_dt) FOR GRAPH FraudGraph {
    SumAccum<INT> @@txn_count;
    SumAccum<DOUBLE> @@total_amount;
    AvgAccum @@avg_risk;
    seed = {card};
    txns = SELECT t FROM seed -(MADE_TXN)- Transaction:t
           WHERE t.txn_dt >= since_dt
           ACCUM @@txn_count += 1, @@total_amount += t.amount, @@avg_risk += t.risk_score;
    PRINT @@txn_count, @@total_amount, @@avg_risk;
}

// 4. Device history check: prior customer uses of this device fingerprint
CREATE QUERY device_history(VERTEX<Customer> cust, VERTEX<Device> dev, DATETIME before_dt) FOR GRAPH FraudGraph {
    SumAccum<INT> @@prior_uses;
    seed = {cust};
    txns = SELECT t FROM seed -(CUSTOMER_TXN)- Transaction:t WHERE t.txn_dt < before_dt;
    hits = SELECT d FROM txns -(USED_DEVICE)- Device:d WHERE d == dev ACCUM @@prior_uses += 1;
    PRINT @@prior_uses;
}

// 5. Similar prior cases via case memory
CREATE QUERY similar_cases_structural(VERTEX<Customer> cust) FOR GRAPH FraudGraph {
    seed = {cust};
    direct = SELECT fc FROM seed -(CASE_CUSTOMER)- FraudCase:fc;
    txns = SELECT t FROM seed -(CUSTOMER_TXN)- Transaction:t;
    attrs = SELECT a FROM txns -((USED_DEVICE|FROM_IP|USED_EMAIL))- :a;
    ring_txns = SELECT t2 FROM attrs -((USED_DEVICE|FROM_IP|USED_EMAIL))- Transaction:t2;
    ring_cases = SELECT fc2 FROM ring_txns -(CASE_TXN)- FraudCase:fc2;
    PRINT direct, ring_cases;
}

INSTALL QUERY evidence_subgraph, shared_attribute_ring, velocity_check, device_history, similar_cases_structural

